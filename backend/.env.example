HHG_ARTIFACT_DIR=/data/hhg_rag_artifacts
HHG_CACHE_ENABLED=true
HHG_CACHE_MAX_SIZE=1000
HHG_CACHE_TTL_SECONDS=3600
HHG_CACHE_VERSION=v1
HHG_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
HHG_DEBUG=false
HHG_LOG_LEVEL=INFO

# Saaras STT
HHG_SAARAS_ENABLED=false
HHG_SAARAS_API_KEY=
HHG_SAARAS_BASE_URL=https://api.sarvam.ai/speech-to-text
HHG_SAARAS_MODEL=saaras:v3
HHG_SAARAS_TIMEOUT_SECONDS=30
HHG_MAX_AUDIO_MB=10

# SLM
HHG_SLM_ENABLED=false
HHG_SLM_PROVIDER=groq
HHG_SLM_BASE_URL=https://api.groq.com/openai/v1/chat/completions
HHG_SLM_MODEL=llama-3.1-8b-instant
HHG_SLM_API_KEY=
HHG_SLM_TIMEOUT_SECONDS=10
HHG_SLM_MAX_TOKENS=256
HHG_SLM_TEMPERATURE=0.0

# Grounding
HHG_GROUNDING_TOP_K=5
HHG_MAX_CONTEXT_CHARS=12000
